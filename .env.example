# 知乎黑客松 OAuth 应用配置
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
# 某些知乎 OAuth 环境不会回传 state；确认该行为后才显式设为 true
ZHIHU_OAUTH_ALLOW_MISSING_STATE=false

# 读取授权用户收藏、关注等用户数据时需要
ZHIHU_ACCESS_SECRET=

# 至少 32 个随机字符，用于加密 OAuth 会话 Cookie
SESSION_SECRET=

# AI 讨论瞬间识别（服务端使用，不要暴露给 Vite 前端）
OPENAI_NEXT_API_KEY=
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
OPENAI_NEXT_MODEL=gpt-5.6-sol
# 精排是紧凑分类任务，单独使用低延迟模型
OPENAI_NEXT_RECOMMEND_MODEL=gpt-5.6-luna

# Upstash Redis / Vercel Marketplace（也兼容 Vercel KV 的 KV_REST_API_* 变量）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 可选：Node 服务监听端口
PORT=4173
